# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# Node (future frontend)
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.local
secrets.json
service-account*.json
*.pem
*.key

# Local app database (SQLite) — regenerated by the seed
*.db
*.sqlite3

# Internal framework source — do not publish (folded into the local PLAN.md instead)
docs/framework.xlsx
docs/validation-tests.csv
docs/validation-tests.md

# Terraform — state holds secrets; tfvars holds config. Keep the .example only.
**/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
.terraform.lock.hcl

# Local tooling artifacts
/tmp/
*.log

# Playwright (browsers are cached in ~/Library/Caches, not the repo)
playwright-report/
test-results/
